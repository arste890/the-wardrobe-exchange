{
  "name": "@kw/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply the-wardrobe-exchange --local",
    "migrate:remote": "wrangler d1 migrations apply the-wardrobe-exchange --remote",
    "seed:local": "wrangler d1 execute the-wardrobe-exchange --local --file=./seed/seed.sql",
    "hash-password": "node ./scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}
