---
import { BRAND } from '@kw/shared/brand';
const user = BRAND.newsletter.buttondownUsername;
---

{
  user ? (
    <form
      class="newsletter"
      action={`https://buttondown.com/api/emails/embed-subscribe/${user}`}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('https://buttondown.com/${user}', 'popupwindow')`}
    >
      <label class="visually-hidden" for="bd-email">Email address</label>
      <div class="newsletter__row">
        <input class="input" type="email" name="email" id="bd-email" placeholder="you@example.com" required autocomplete="email" />
        <button class="btn" type="submit">Join</button>
      </div>
      <p class="small muted">A short note when new pieces land. No more than a few a month. Unsubscribe any time.</p>
    </form>
  ) : (
    <p class="small muted">Follow on Instagram for new arrivals.</p>
  )
}

<style>
  .newsletter__row {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .newsletter__row .input {
    flex: 1;
    min-width: 0;
  }
</style>
