---
import Base from '../../layouts/Base.astro';
import { API_URL } from '../../lib/api';
---

<Base title="Admin" noindex>
  <section class="section">
    <div class="wrap admin" id="admin" data-api={API_URL} data-base={import.meta.env.BASE_URL}>
      <p class="muted">Loading admin…</p>
    </div>
  </section>
</Base>

<script>
  import { initAdmin } from '../../components/admin';
  initAdmin(document.getElementById('admin')!);
</script>

<style is:global>
  .admin h1 {
    font-size: var(--fs-xl);
    margin: 0;
  }
  .admin__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .admin__tabs {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .admin__tabs button {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    cursor: pointer;
  }
  .admin__tabs button.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .admin table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    background: var(--surface);
  }
  .admin th,
  .admin td {
    text-align: left;
    padding: 10px 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .admin tr[data-row] {
    cursor: pointer;
  }
  .admin tr[data-row]:hover {
    background: var(--surface-2);
  }
  .admin .thumb {
    width: 44px;
    height: 55px;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .admin .pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--surface-2);
  }
  .admin .pill--available {
    background: #dfeadf;
    color: var(--ok);
  }
  .admin .pill--sold {
    background: var(--sold);
    color: #fff;
  }
  .admin .pill--reserved {
    background: #f3e3cf;
    color: var(--warn);
  }
  .admin .pill--error {
    background: #f2dcd7;
    color: var(--danger);
  }
  .admin .form {
    display: grid;
    gap: var(--space-4);
    background: var(--surface);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .admin .form__row {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .admin .field {
    margin: 0;
  }
  .admin .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--space-3);
  }
  .admin .photo {
    position: relative;
    display: grid;
    gap: 4px;
    font-size: var(--fs-xs);
  }
  .admin .photo img {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .admin .photo.is-cover img {
    outline: 2px solid var(--ink);
  }
  .admin .photo select {
    font-size: var(--fs-xs);
    padding: 4px;
  }
  .admin .photo__actions {
    display: flex;
    gap: 4px;
  }
  .admin .photo__actions button {
    flex: 1;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 3px;
    font-size: 11px;
    cursor: pointer;
  }
  .admin .drop {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: var(--space-5);
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .admin .drop.is-over {
    background: var(--surface-2);
    border-color: var(--ink);
  }
  .admin .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .admin .actions .btn {
    min-height: 40px;
    padding: 0 var(--space-4);
  }
  .admin .btn--danger {
    border-color: var(--danger);
    color: var(--danger);
  }
  .admin .notice {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--surface-2);
    font-size: var(--fs-sm);
  }
  .admin .notice--error {
    background: #f2dcd7;
    color: var(--danger);
  }
  .admin .notice--ok {
    background: #dfeadf;
    color: var(--ok);
  }
  .admin pre {
    white-space: pre-wrap;
    font-size: 12px;
    background: var(--surface-2);
    padding: var(--space-3);
    border-radius: var(--radius);
  }
  .admin .address {
    white-space: pre-line;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 13px;
  }
</style>
