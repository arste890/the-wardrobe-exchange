---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { BRAND } from '@kw/shared/brand';
import { HANDLING_TEXT } from '@kw/shared/shipping';
import { CATEGORY_LABELS } from '@kw/shared/types';
import type { Category } from '@kw/shared/types';
import { fetchCatalog, liveItems, url, SITE_URL } from '../lib/api';
import { organizationJsonLd } from '../lib/schema';

const catalog = await fetchCatalog();
const live = liveItems(catalog);
const newest = live.slice(0, 8);
const hero = live.find((i) => i.cover?.kind === 'studio') ?? live[0];
const categories = [...new Set(live.map((i) => i.category))] as Category[];
const recentlySold = catalog.items.filter((i) => i.status === 'sold').slice(0, 4);
---

<Base title={BRAND.name} description={BRAND.description} jsonLd={[organizationJsonLd(SITE_URL)]}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Pre-owned · One of each</p>
        <h1>{BRAND.tagline}</h1>
        <p class="hero__lede">{BRAND.description}</p>
        <div class="cluster">
          <a class="btn" href={url('/shop')}>Shop the edit</a>
          <a class="btn btn--ghost" href={url('/policies/photos')}>How we photograph</a>
        </div>
      </div>
      <div class="hero__media">
        {
          hero?.cover ? (
            <a href={url(`/item/${hero.slug}`)} aria-label={`${hero.brand} ${hero.title}`}>
              <img src={hero.cover.large} srcset={`${hero.cover.medium} 1000w, ${hero.cover.large} 1600w`} sizes="(min-width: 900px) 45vw, 100vw" width={hero.cover.width || 1136} height={hero.cover.height || 1408} alt={hero.cover.alt || `${hero.brand} ${hero.title}`} fetchpriority="high" />
              <span class="badge badge--light hero__badge">{hero.cover.kind === 'studio' ? 'Studio rendering' : 'Actual item'}</span>
            </a>
          ) : (
            <div class="hero__placeholder" />
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>New arrivals</h2>
        <a href={url('/shop')} class="small">View all →</a>
      </div>
      {
        newest.length ? (
          <div class="grid">{newest.map((i, n) => <ProductCard item={i} eager={n < 2} />)}</div>
        ) : (
          <p class="muted">New pieces are being photographed. Check back shortly or join the list below.</p>
        )
      }
    </div>
  </section>

  {
    categories.length > 1 && (
      <section class="section section--tight">
        <div class="wrap">
          <h2>Shop by category</h2>
          <ul class="cats">
            {categories.map((c) => (
              <li>
                <a href={url(`/shop?category=${c}`)}>{CATEGORY_LABELS[c]}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section promise">
    <div class="wrap promise__grid">
      <div>
        <p class="eyebrow">Honest photography</p>
        <p>Every listing pairs clean studio renderings with unretouched photos of the actual garment, flaws included. You always know exactly what you are buying.</p>
      </div>
      <div>
        <p class="eyebrow">Described, not oversold</p>
        <p>Condition grades with a plain-English meaning, the brand's size on the label, and flat measurements where we have them — so you can compare with something that already fits.</p>
      </div>
      <div>
        <p class="eyebrow">Direct, not marketplace</p>
        <p>Buying here means no platform fees baked into the price. Secure checkout by Stripe and tracked shipping, {HANDLING_TEXT}.</p>
      </div>
    </div>
  </section>

  {
    recentlySold.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section__head">
            <h2>Recently found homes</h2>
            <a href={url('/shop?status=sold')} class="small">Archive →</a>
          </div>
          <div class="grid">{recentlySold.map((i) => <ProductCard item={i} />)}</div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding: var(--space-7) 0 var(--space-6);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
    }
  }
  .hero h1 {
    font-size: var(--fs-3xl);
    max-width: 14ch;
  }
  .hero__lede {
    max-width: 48ch;
    font-size: var(--fs-lg);
    color: var(--ink-2);
    margin-bottom: var(--space-6);
  }
  .hero__media a {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__badge {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
  }
  .hero__placeholder {
    aspect-ratio: 4 / 5;
    background: linear-gradient(135deg, var(--surface-2), var(--line));
    border-radius: var(--radius);
  }
  .section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .section--tight {
    padding-top: 0;
  }
  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cats a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
  }
  .cats a:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
    text-decoration: none;
  }
  .promise {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .promise__grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 760px) {
    .promise__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }
</style>
