---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import BuyBox from '../../components/BuyBox.astro';
import Measurements from '../../components/Measurements.astro';
import ConditionBlock from '../../components/ConditionBlock.astro';
import SimilarItems from '../../components/SimilarItems.astro';
import { marked } from 'marked';
import { CATEGORY_LABELS, CONDITION_LABELS } from '@kw/shared/types';
import type { CatalogItem } from '@kw/shared/types';
import { fetchCatalog, similarItems, url, SITE_URL } from '../../lib/api';
import { productJsonLd, breadcrumbJsonLd } from '../../lib/schema';
import { plainText } from '../../lib/format';

export async function getStaticPaths() {
  const catalog = await fetchCatalog();
  return catalog.items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props {
  item: CatalogItem;
}
const { item } = Astro.props;
const catalog = await fetchCatalog();
const similar = similarItems(catalog, item);
const pageUrl = `${SITE_URL}${url(`/item/${item.slug}`)}`;
const description = `${item.brand} ${item.title}, size ${item.size_label}. ${CONDITION_LABELS[item.condition_grade]}. ${plainText(item.description_md)}`.slice(0, 160);
const descriptionHtml = marked.parse(item.description_md || '');
const sold = item.status === 'sold';
---

<Base
  title={`${item.brand} ${item.title} — Size ${item.size_label}`}
  description={description}
  ogImage={item.cover?.jpg}
  ogType="product"
  canonical={pageUrl}
  jsonLd={[
    productJsonLd(item, pageUrl, `${SITE_URL}${url('/policies/terms')}`),
    breadcrumbJsonLd([
      { name: 'Shop', url: `${SITE_URL}${url('/shop')}` },
      { name: CATEGORY_LABELS[item.category], url: `${SITE_URL}${url(`/shop?category=${item.category}`)}` },
      { name: `${item.brand} ${item.title}`, url: pageUrl },
    ]),
  ]}
  extraMeta={[
    { property: 'product:price:amount', content: (item.price_cents / 100).toFixed(2) },
    { property: 'product:price:currency', content: 'USD' },
    { property: 'product:availability', content: sold ? 'out of stock' : 'in stock' },
    { property: 'product:condition', content: 'used' },
    { property: 'product:retailer_item_id', content: item.sku },
  ]}
>
  <article class="pdp wrap">
    <nav class="pdp__crumbs small muted" aria-label="Breadcrumb">
      <a href={url('/shop')}>Shop</a> / <a href={url(`/shop?category=${item.category}`)}>{CATEGORY_LABELS[item.category]}</a> / <span>{item.brand}</span>
    </nav>
    <div class="pdp__grid">
      <div class="pdp__gallery">
        <Gallery photos={item.photos} title={`${item.brand} ${item.title}`} sold={sold} />
      </div>
      <div class="pdp__side">
        <BuyBox item={item} />
      </div>
    </div>

    <div class="pdp__details">
      <section class="pdp__desc">
        <h2>About this piece</h2>
        <div class="prose" set:html={descriptionHtml} />
        <p class="small muted">SKU {item.sku}</p>
      </section>
      <ConditionBlock item={item} />
      <Measurements measurements={item.measurements} />
    </div>

    <SimilarItems items={similar} title={sold ? 'Still available' : 'You may also like'} />
  </article>
</Base>

<style>
  .pdp {
    padding-top: var(--space-5);
  }
  .pdp__crumbs {
    margin-bottom: var(--space-4);
  }
  .pdp__grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 960px) {
    .pdp__grid {
      grid-template-columns: 1.25fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .pdp__side {
      position: sticky;
      top: 88px;
    }
  }
  .pdp__details {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-8);
    max-width: 72ch;
  }
  @media (min-width: 960px) {
    .pdp__details {
      grid-template-columns: 1fr 1fr;
      max-width: none;
    }
    .pdp__desc {
      grid-column: 1 / -1;
      max-width: 72ch;
    }
  }
</style>
